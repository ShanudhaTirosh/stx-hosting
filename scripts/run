#!/usr/bin/env bash

# Inspired on https://github.com/adriancooney/Taskfile
#
# Install an alias, to be able to simply execute `run`
# echo 'alias run=./scripts/run' >> ~/.aliases
#
# Define Docker Compose command prefix...
set -e

if [ $? == 0 ]; then
    DOCKER_COMPOSE="docker compose"
else
    DOCKER_COMPOSE="docker-compose"
fi

function help {
    echo "$0 <task> <args>"
    echo "Tasks:"
    compgen -A function | cat -n
}

function logs {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T stx tail -f storage/logs/laravel.log
}
function test {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -T stx php artisan test --testsuite=Feature -p
}

function sync:cdn {
    php artisan sync:cdn --env=secrets
}

function db:reset {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -u www-data stx php artisan migrate:fresh --seed
}
function db:reset-prod {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -u www-data stx php artisan migrate:fresh --force --seed --seeder=ProductionSeeder ||
        php artisan migrate:fresh --force --seed --seeder=ProductionSeeder
}
function stx {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -u www-data stx sh
}
function coolify {
    stx "$@"
}

function stx:root {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec stx sh
}
function coolify:root {
    stx:root "$@"
}

function stx:proxy {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec stx-proxy sh
}
function coolify:proxy {
    stx:proxy "$@"
}

function redis {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec redis redis-cli
}

function vite {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec vite bash
}

function tinker {
    docker compose -f docker-compose.yml -f docker-compose.dev.yml exec -u www-data stx php artisan tinker
}

function default {
    help
}

TIMEFORMAT="Task completed in %3lR"
time "${@:-default}"
