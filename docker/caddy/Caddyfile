# 6. Customer Custom Domains (On-Demand TLS with validation)
https:// {
    tls {
        on_demand
    }

    reverse_proxy stx:8080 {
        header_up Host {host}
        header_up X-Real-IP {remote}
        header_up X-Forwarded-For {remote}
        header_up X-Forwarded-Proto {scheme}
    }
}

