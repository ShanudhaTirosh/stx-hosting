PUBLIC_HOST=pay.example.com            # staff and customers use this
PHONE_API_HOST=phones.pay.example.com  # the Android app's server address (https://...)
PV_DB_PASSWORD=
PV_JWT_SECRET=                         # openssl rand -hex 32
PV_DATA_KEY=                           # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"  BACK THIS UP
PV_BANK_ACCOUNT_TAIL=                  # last digits of your ComBank account
PV_PAY_TO_ACCOUNT_NAME=
PV_PAY_TO_ACCOUNT_NUMBER=
# ComBank WhatsApp Banking Automation
PV_COMBANK_NIC=                           # Merchant National Identity Card or Passport Number registered with ComBank
PV_COMBANK_WHATSAPP_NUMBER=               # ComBank official WhatsApp number (e.g. 94771234567)
PV_WHATSAPP_BOT_SECRET=                   # Secret shared between API and bot daemon
PV_WHATSAPP_SYNC_INTERVAL_MINUTES=60      # Auto-sync interval in minutes (default: 60 = every 1 hour)
PV_BOT_SYNC_ON_CLAIM=false                # Trigger on-demand bot sync when customer submits proof slip

# AI Receipt Extraction & Proof Matching
# Options for PV_AI_PROVIDER: 'gemini' (Free Google AI Studio API), 'ollama' (Self-hosted 2-4GB RAM CPU), 'anthropic', or 'none'
PV_EXTRACTION_ENABLED=true
PV_AI_PROVIDER=gemini
PV_GEMINI_API_KEY=                        # Free API key from https://aistudio.google.com/
PV_GEMINI_MODEL=gemini-2.5-flash          # Fast & multimodal model
# If using self-hosted lightweight CPU model (max 2-4 GB RAM, no GPU required):
# PV_AI_PROVIDER=ollama
# PV_OLLAMA_URL=http://localhost:11434
# PV_OLLAMA_MODEL=llama3.2-vision

# Cross-Platform Payment Verification API
# Protects /api/v1/external/* endpoints for your e-commerce, web apps, and POS
PV_EXTERNAL_API_KEY=                      # openssl rand -hex 24 (or custom secret)

# Supabase Integration (Free cloud tier or Self-Hosted Supabase)
# If using Supabase directly as primary DB, set:
# PV_DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres?sslmode=require
# If using Realtime / REST synchronization to Supabase:
PV_SUPABASE_SYNC_ENABLED=false            # set to true to push payments/claims to Supabase
PV_SUPABASE_URL=                          # e.g. https://[YOUR-PROJECT-REF].supabase.co or http://localhost:8000
PV_SUPABASE_SERVICE_KEY=                  # Supabase service_role key (bypasses RLS for sync)

# Outbound Webhooks (Notify external shop when payments are verified)
PV_EXTERNAL_WEBHOOK_URL=                  # e.g. https://your-shop.com/api/webhooks/payverify
PV_EXTERNAL_WEBHOOK_SECRET=               # Secret key used to sign HMAC-SHA256 X-PayVerify-Signature header
PV_AUTO_RECEIPT_TO_LEDGER=true            # Auto-create BankTransaction from vas.combank.net receipts

