# Supabase Full Stack Environment Configuration Example
# Copy to .env or configure in your deployment environment

# 1. Supabase Project Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-admin-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# 2. Authentication & Provisioning
SUPABASE_AUTH_ENABLED=true
SUPABASE_AUTO_CREATE_TEAM=true

# 3. Storage Buckets Configuration
SUPABASE_STORAGE_LOGOS=logos
SUPABASE_STORAGE_TEMPLATE_ASSETS=template-assets
SUPABASE_STORAGE_INVOICES=invoices
SUPABASE_STORAGE_USER_UPLOADS=user-uploads

# 4. Webhook & Secret Management (Used by Supabase Edge Functions)
STRIPE_WEBHOOK_SECRET=whsec_your_stripe_webhook_secret
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM="STX Hosting <notifications@stxapp.io>"

# 5. Local Development Ports (When running 'npx supabase start')
# API URL:        http://127.0.0.1:54321
# DB URL:         postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Studio URL:     http://127.0.0.1:54323
# Inbucket SMTP:  http://127.0.0.1:54324

