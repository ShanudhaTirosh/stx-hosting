APP_ENV=production
APP_DEBUG=false
APP_URL=https://mail.example.com
# 32 random bytes, base64: php -r "echo base64_encode(random_bytes(32)),PHP_EOL;"
APP_KEY=

# WildDuck API (server-side only, never sent to the browser)
WILDDUCK_API_URL=http://127.0.0.1:8080
# Service token: used ONLY for POST /authenticate. After login each session uses its own user-scoped token.
WILDDUCK_API_TOKEN=
WILDDUCK_TIMEOUT=15
WILDDUCK_VERIFY_TLS=true

# Uploads (must not exceed WildDuck's limits)
MAX_ATTACHMENT_MB=20
MAX_MESSAGE_MB=25

SESSION_LIFETIME_MIN=480
SESSION_COOKIE_SECURE=true

# Optional: keep sessions/rate-limit files outside the project directory
# STORAGE_PATH=/var/lib/webmail

# Reverse proxy / load balancer in front of nginx? List its address(es) so the real client IP (X-Forwarded-For) is used for rate limiting.
# Leave empty if clients connect to nginx directly. Never use 0.0.0.0/0.
# TRUSTED_PROXIES=10.0.0.0/8,127.0.0.1
