# ------------------------------------------------------------------------------
# SELF-HOSTED SUPABASE STACK ENVIRONMENT CONFIGURATION
# ------------------------------------------------------------------------------

# Database & Passwords
POSTGRES_PASSWORD=your_secure_postgres_password_at_least_16_chars

# Kong Gateway & Studio Ports
KONG_PORT=8000
STUDIO_PORT=8001

# URLs
SITE_URL=http://localhost:80
SUPABASE_PUBLIC_URL=http://localhost:8000
ADDITIONAL_REDIRECT_URLS=http://localhost:80/auth/callback

# JWT & API Keys (Generate via openssl or supabase cli)
# JWT Secret MUST be at least 32 characters
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_min_32_characters_random
SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_here

# Realtime Secret Key
REALTIME_SECRET_KEY_BASE=your_realtime_secret_key_base_32_chars_min

# Self-Hosted WildDuck / ZoneMTA SMTP Configuration for Auth Emails
SMTP_HOST=mail.stxcloud.local
SMTP_PORT=587
SMTP_USER=no-reply@stxcloud.local
SMTP_PASS=your_smtp_auth_password_here
