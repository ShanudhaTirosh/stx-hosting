# STX Discord Bot Environment Configuration
# Node environment
NODE_ENV=development
PORT=3050

# Discord Bot Credentials
DISCORD_BOT_TOKEN=your_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_test_guild_id_optional

# Supabase Credentials (Connects to STX Self-Hosted Supabase)
SUPABASE_URL=http://localhost:8000/supabase
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Internal Webhook Shared Secret (for Laravel invoice events)
BOT_INTERNAL_SECRET=change_this_to_a_secure_shared_secret

# Rate Limit & Protection Thresholds
MAX_OPEN_TICKETS_PER_USER=2
DEFAULT_RAID_THRESHOLD_JOINS=10
DEFAULT_RAID_THRESHOLD_SECONDS=10
ORDER_RATE_LIMIT_ATTEMPTS=3
ORDER_RATE_LIMIT_WINDOW_SECONDS=900
