# Self-Hosted Stack Environment Configuration
DOMAIN=yourdomain.com
ACME_EMAIL=admin@yourdomain.com
SITE_URL=https://app.yourdomain.com
SUPABASE_PUBLIC_URL=https://api.yourdomain.com
ADDITIONAL_REDIRECT_URLS=https://app.yourdomain.com/auth/callback,https://localhost:8000/auth/callback

# Supabase Keys
POSTGRES_PASSWORD=generate_a_secure_postgres_password
SUPABASE_JWT_SECRET=generate_a_secure_jwt_secret_at_least_32_characters
SUPABASE_ANON_KEY=generate_via_bootstrap_script
SUPABASE_SERVICE_ROLE_KEY=generate_via_bootstrap_script
REALTIME_SECRET_KEY_BASE=generate_random_64_character_hex_key

# Supabase Studio Credentials
STUDIO_USER=admin
STUDIO_PASSWORD=generate_studio_password
STUDIO_BCRYPT_PASSWORD=generate_bcrypt_hash

# WildDuck Mail Stack
WILDDUCK_API_TOKEN=generate_secure_wildduck_api_token
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=generate_mongo_password
MONGO_DB=wildduck
MONGO_USER=wildduck
MONGO_PASSWORD=generate_mongo_wildduck_password
REDIS_PASSWORD=generate_redis_password
DKIM_KEY_SELECTOR=s1
DKIM_PRIVATE_KEY=""
MAIL_SERVER_HOSTNAME=mail.yourdomain.com
MAIL_DOMAIN=yourdomain.com

# Webmail
WEBMAIL_DOMAIN=webmail.yourdomain.com
APP_KEY=base64:generate_via_artisan_or_bootstrap
APP_ENV=production
APP_DEBUG=false
APP_URL=https://webmail.yourdomain.com
WILDDUCK_API_BASE=http://wildduck:8080
WILDDUCK_IMAP_HOST=wildduck
WILDDUCK_IMAP_PORT=993
WILDDUCK_SMTP_HOST=zonemta
WILDDUCK_SMTP_PORT=587
DEFAULT_MAIL_DOMAIN=yourdomain.com
PORTAL_URL=https://app.yourdomain.com/portal/mail

