# ==============================================================================
# STX ENTERPRISES CLOUD PLATFORM - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env and configure values for your environment.
# NEVER commit real credentials, private keys, or API tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION CONFIGURATION
# ------------------------------------------------------------------------------
APP_NAME="STX Hosting"
APP_ENV=local                    # local, staging, production, testing
APP_KEY=                         # Generate with: php artisan key:generate
APP_DEBUG=true                   # Set to false in production
APP_URL=http://localhost:8000
APP_PORT=8000
APP_ID=stx-hosting-platform
LOG_CHANNEL=stack
LOG_LEVEL=debug
APP_TIMEZONE=UTC

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (PostgreSQL 15 / 16)
# ------------------------------------------------------------------------------
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=stx
DB_USERNAME=stx
DB_PASSWORD=your_secure_postgres_password
# Optional read/write split replicas:
# DB_READ_HOST=replica1.db.internal,replica2.db.internal
# DB_READ_PORT=5432
# DB_READ_USERNAME=stx_read
# DB_READ_PASSWORD=your_replica_password
# DB_STICKY=true

# ------------------------------------------------------------------------------
# 3. CACHE, SESSION & REDIS (Redis 7)
# ------------------------------------------------------------------------------
CACHE_DRIVER=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
REDIS_CLIENT=phpredis            # phpredis or predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=your_redis_password
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

# ------------------------------------------------------------------------------
# 4. QUEUE & LARAVEL HORIZON
# ------------------------------------------------------------------------------
QUEUE_CONNECTION=redis
HORIZON_PREFIX=stx-horizon:
# Worker pool concurrency for production:
# HORIZON_DEPLOYMENTS_PROCESSES=60
# HORIZON_CRONS_PROCESSES=60
# HORIZON_HIGH_PROCESSES=60
# HORIZON_DEFAULT_PROCESSES=40
# HORIZON_MAINTENANCE_PROCESSES=10
# HORIZON_WEBHOOKS_PROCESSES=10

# ------------------------------------------------------------------------------
# 5. WEBSOCKETS & BROADCASTING (Laravel Reverb)
# ------------------------------------------------------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=stx-app
REVERB_APP_KEY=stx-reverb-key
REVERB_APP_SECRET=stx-reverb-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=6001
REVERB_SCHEME=http
# Server-side broadcasts internally target PUSHER_BACKEND_*:
PUSHER_BACKEND_HOST=127.0.0.1
PUSHER_BACKEND_PORT=6001

# ------------------------------------------------------------------------------
# 6. TERMINAL WEBSOCKET SERVER
# ------------------------------------------------------------------------------
TERMINAL_PORT=6002

# ------------------------------------------------------------------------------
# 7. EMAIL (SMTP & TRANSACTIONAL)
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025                   # Port 1025 for Mailpit in dev, 587 for Zone-MTA / SMTP in prod
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="no-reply@stxhosting.com"
MAIL_FROM_NAME="STX Hosting"

# ------------------------------------------------------------------------------
# 8. FILE STORAGE & PRIVATE PROOFS (Local / S3 / Cloudflare R2)
# ------------------------------------------------------------------------------
FILESYSTEM_DISK=local
PAYMENT_PROOFS_DISK=payment_proofs
CHAT_DISK=local
COMMERCE_STORAGE_DRIVER=supabase # supabase (private bucket with RLS) or disk
# S3 / Cloudflare R2 credentials (when using S3 disks):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=stx-backups
# AWS_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=false

# ------------------------------------------------------------------------------
# 9. SELF-HOSTED SUPABASE INTEGRATION (BaaS)
# ------------------------------------------------------------------------------
SUPABASE_URL=http://localhost:8000
SUPABASE_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key
SUPABASE_JWT_SECRET=your_supabase_jwt_secret_at_least_32_characters
SUPABASE_AUTH_ENABLED=false      # Set true to delegate auth to GoTrue REST API
SUPABASE_AUTO_CREATE_TEAM=true
SUPABASE_STORAGE_LOGOS=logos
SUPABASE_STORAGE_TEMPLATE_ASSETS=template-assets
SUPABASE_STORAGE_INVOICES=invoices
SUPABASE_STORAGE_USER_UPLOADS=user-uploads
SUPABASE_PROOF_BUCKET=payment-proofs

# ------------------------------------------------------------------------------
# 10. COMMERCE & PAYVERIFY SLIP VERIFICATION API
# ------------------------------------------------------------------------------
COMMERCE_BUSINESS_NAME="STX Enterprises"
COMMERCE_BUSINESS_ADDRESS="Level 14, Digital Empire Tower, Colombo, Sri Lanka"
COMMERCE_BUSINESS_EMAIL="billing@stxenterprises.com"

# PayVerify AI verification integration
PAYVERIFY_URL=http://localhost:8000/api/v1/external
PAYVERIFY_API_KEY=dev_test_key
PAYVERIFY_TIMEOUT_SECONDS=35
PAYVERIFY_AUTO_APPROVE=true
PAYVERIFY_AUTO_APPROVE_MIN_CONFIDENCE=0.90
PAYVERIFY_MANUAL_REVIEW_MIN_CONFIDENCE=0.60
PAYVERIFY_MAX_DATE_SKEW_DAYS=7

# ------------------------------------------------------------------------------
# 11. WILDDUCK EMAIL HOSTING & WEBMAIL UI
# ------------------------------------------------------------------------------
WILDDUCK_API_URL=http://localhost:8080
WILDDUCK_API_TOKEN=your_secure_wildduck_api_token
WILDDUCK_IMAP_HOST=localhost
WILDDUCK_IMAP_PORT=993
WILDDUCK_SMTP_HOST=localhost
WILDDUCK_SMTP_PORT=587
DEFAULT_MAIL_DOMAIN=yourdomain.com
WEBMAIL_URL=https://webmail.yourdomain.com

# ------------------------------------------------------------------------------
# 12. OAUTH & SOCIAL LOGIN (Socialite Providers)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_TENANT=

DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:8000/auth/github/callback

AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_REDIRECT_URI=http://localhost:8000/auth/azure/callback
AZURE_TENANT_ID=

# ------------------------------------------------------------------------------
# 13. CLOUDFLARE PLATFORM & DOMAIN CONNECT
# ------------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
DOMAIN_CONNECT_PROVIDER_ID=stxhosting.com
DOMAIN_CONNECT_SERVICE_ID=hosting
DOMAIN_CONNECT_KEY_ID=_dcpubkeyv1
DOMAIN_CONNECT_PRIVATE_KEY=

# ------------------------------------------------------------------------------
# 14. SERVER SSH & LOCAL DEV CONFIGURATION
# ------------------------------------------------------------------------------
SSH_MUX_ENABLED=true
STX_CONTAINER_ROLE=all
DEV_SEED_IP=
DEV_SENTINEL_URL=
SERVER_TIMING_ENABLED=true
VITE_HOST=localhost
VITE_PORT=5173
DUSK_DRIVER_URL=http://selenium:4444

# ------------------------------------------------------------------------------
# 15. STX COMMUNITY & STORE DISCORD BOT
# ------------------------------------------------------------------------------
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
BOT_INTERNAL_SECRET=
DISCORD_BOT_PORT=3050
